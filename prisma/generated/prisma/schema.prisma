model Api {
  id          Int        @id @default(autoincrement())
  parentId    Int?
  type        ApiType
  title       String     @db.VarChar(50)
  code        String?    @unique @db.VarChar(50)
  method      ApiMethod?
  path        String?    @db.VarChar(100)
  description String?    @db.VarChar(100)
  sort        Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now())
  Api         Api?       @relation("ApiToApi", fields: [parentId], references: [id])
  other_Api   Api[]      @relation("ApiToApi")
}

enum ApiMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
}

enum ApiType {
  DIRECTORY
  API
}

enum MenuType {
  DIRECTORY
  MENU
  FEATURE
}

enum FileType {
  IMAGE //图片
  VIDEO //视频\
  AUDIO //音频
  TEXT //普通文件
  APPLICATION //某种二进制文件，包括word pdf excel等
}

model File {
  id        Int      @id @default(autoincrement())
  fileType  FileType
  fileName  String   @db.VarChar(100)
  adress    String?  @db.VarChar(100)
  size      Int      @default(0)
  isShow    Boolean? @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model Menu {
  id          Int      @id @default(autoincrement())
  parentId    Int?
  type        MenuType
  title       String   @db.VarChar(50)
  icon        String?  @db.VarChar(50)
  code        String?  @unique @db.VarChar(50)
  path        String?  @db.VarChar(100)
  description String?  @db.VarChar(100)
  i18nKey     String?  @db.VarChar(50)
  sort        Int      @default(0)
  isShow      Boolean? @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  Menu        Menu?    @relation("MenuToMenu", fields: [parentId], references: [id])
  other_Menu  Menu[]   @relation("MenuToMenu")
}

model Role {
  id                 Int        @id @default(autoincrement())
  code               String     @unique @db.VarChar(20)
  name               String     @unique @db.VarChar(20)
  description        String?    @db.VarChar(100)
  menuPermissions    String[]
  featurePermissions String[]
  apiPermissions     String[]
  createAt           DateTime   @default(now())
  updateAt           DateTime   @default(now())
  UserRole           UserRole[]
}

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

model Sysconfig {
  id            Int      @id @default(autoincrement())
  fileUploadMax Int      @default(3)
  ossBucket     String   @db.VarChar(20)
  createAt      DateTime @default(now())
  updateAt      DateTime @default(now())
}

model User {
  id           Int        @id @default(autoincrement())
  username     String     @unique @db.VarChar(50)
  password     String     @db.VarChar(200)
  nickName     String?    @db.VarChar(50)
  email        String?    @db.VarChar(50)
  headPic      String?    @db.VarChar(100)
  phone        String?    @db.VarChar(20)
  isFrozen     Boolean    @default(false)
  isSuperAdmin Boolean    @default(false)
  createAt     DateTime   @default(now())
  updateAt     DateTime   @default(now())
  UserRole     UserRole[]
}

model UserRole {
  id         Int      @id @default(autoincrement())
  userId     Int
  roleId     Int
  createTime DateTime @default(now())
  Role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@index([userId])
}
